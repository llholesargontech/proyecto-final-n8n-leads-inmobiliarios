    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nlet parsed;\ntry { parsed = typeof input.output === \"string\" ? JSON.parse(input.output) : input.output; } catch (e) { parsed = null; }\nconst clases = [\"caliente\", \"tibio\", \"frio\", \"revision_humana\"];\nconst acciones = [\"contactar_agente\", \"enviar_opciones\", \"pedir_datos\", \"revision_humana\"];\nconst texto = JSON.stringify(parsed || {}).toLowerCase();\nconst salidaValida = parsed && clases.includes(parsed.clasificacion) && acciones.includes(parsed.accion) && typeof parsed.confianza === \"number\" && parsed.confianza >= 0 && parsed.confianza <= 1;\nconst promete = /confirmar visita|coordinar una visita|disponibilidad confirmada|precio exacto/.test(texto);\nconst final = salidaValida && !promete ? parsed : { clasificacion: \"revision_humana\", accion: \"revision_humana\", mensaje: \"La consulta queda pendiente de revision humana para evitar confirmar informacion no verificada.\", confianza: 0.5 };\nconst canal = $(\"Edit Fields\").first().json.message?.chat?.id ? \"telegram\" : \"webhook\";\nreturn [{ json: { output: JSON.stringify(final, null, 2), canal } }];"
      },
