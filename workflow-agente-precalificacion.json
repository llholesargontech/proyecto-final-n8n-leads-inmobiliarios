    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(item => item.json);\nconst source = $(\"Edit Fields\").first().json;\nconst leadMessage = source.mensaje || \"\";\nconst leadId = source.lead_id || \"demo-lead-001\";\nconst normalized = leadMessage.toLowerCase();\nconst hasProperty = /(departamento|casa|ph|local|terreno|oficina)/.test(normalized);\nconst hasZone = /(caballito|palermo|belgrano|recoleta|zona|barrio)/.test(normalized);\nconst hasBudget = /[0-9]/.test(normalized);\nconst datosCompletos = hasProperty && hasZone && hasBudget;\nconst accionSugerida = datosCompletos ? \"enviar_opciones\" : \"pedir_datos\";\nconst sheetOk = rows.length > 0 && !rows.some(row => row.error || row.errorMessage || row.statusCode >= 400);\nconst valid = leadMessage.trim().length > 0 && sheetOk;\nreturn [{ json: { valid, sheet_ok: sheetOk, lead_id: leadId, mensaje: leadMessage, datos_completos: datosCompletos, accion_sugerida: accionSugerida, sheet_data: rows } }];"
      },
      "type": "n8n-nodes-base.code",
