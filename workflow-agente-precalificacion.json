    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(item => item.json);\nconst source = $(\"Edit Fields\").first().json;\nconst leadMessage = source.mensaje || \"\";\nconst leadId = source.lead_id || \"demo-lead-001\";\nconst sessionId = source.session_id || leadId;\nconst canal = source.canal || \"webhook\";\nconst telegramChatId = source.telegram_chat_id || null;\nconst remitenteId = source.remitente_id || leadId;\nconst remitenteNombre = source.remitente_nombre || \"\";\nconst normalized = leadMessage.toLowerCase();\nconst hasProperty = /(departamento|casa|ph|local|terreno|oficina)/.test(normalized);\nconst hasZone = /(caballito|palermo|belgrano|recoleta|zona|barrio)/.test(normalized);\nconst hasBudget = /[0-9]/.test(normalized);\nconst datosCompletos = hasProperty && hasZone && hasBudget;\nconst accionSugerida = datosCompletos ? \"enviar_opciones\" : \"pedir_datos\";\nconst sheetOk = rows.length > 0 && !rows.some(row => row.error || row.errorMessage || row.statusCode >= 400);\nconst valid = leadMessage.trim().length > 0 && sheetOk;\nreturn [{ json: { valid, sheet_ok: sheetOk, lead_id: leadId, session_id: sessionId, canal, telegram_chat_id: telegramChatId, remitente_id: remitenteId, remitente_nombre: remitenteNombre, mensaje: leadMessage, datos_completos: datosCompletos, accion_sugerida: accionSugerida, sheet_data: rows } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
